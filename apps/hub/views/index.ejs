<header>
    <h1 class="logo-text"><%= textos.MARCA.nombre %><span class="logo-tld"><%= textos.MARCA.tld %></span></h1>
    <p class="tagline"><%= textos.MARCA.lema %></p>
    <div class="mana-symbols" aria-label="<%= textos.MANA.etiqueta %>">
        <% textos.MANA.colores.forEach(({ clase, titulo }) => { %>
        <i class="ms ms-cost <%= clase %>" title="<%= titulo %>"></i>
        <% }); %>
    </div>
</header>

<section class="section-intro">
    <h2><%= textos.PORTADA.intro.titulo %></h2>
    <p><%= textos.PORTADA.intro.cuerpo %></p>
</section>

<% if (entradas.length) { %>
<section class="guias">
    <h2><%= textos.PORTADA.guias.titulo %></h2>
    <p class="guias-intro"><%= textos.PORTADA.guias.intro %></p>
    <ul class="entradas">
        <% entradas.forEach(({ slug, titulo, descripcion }) => { %>
        <li class="entrada">
            <h3><a href="/blog/<%= slug %>"><%= titulo %></a></h3>
            <p><%= descripcion %></p>
        </li>
        <% }); %>
    </ul>
</section>
<% } %>

<section class="prueba">
    <h2><%= textos.PORTADA.prueba.titulo %></h2>
    <p><%= textos.PORTADA.prueba.cuerpo %></p>
</section>

<nav class="cards" aria-label="<%= textos.CIERRE.etiqueta %>">
    <a href="<%= cta %>" class="card" rel="noopener">
        <%= textos.CIERRE.llamada %>
        <span class="card-nota"><%= textos.CIERRE.nota %></span>
    </a>
    <p class="cards-nota">
        <%= textos.CIERRE.portada.antes %>
        <a href="<%= comoFunciona %>" rel="noopener"><%= textos.CIERRE.portada.enlace %></a><%= textos.CIERRE.portada.despues %>
    </p>
</nav>
