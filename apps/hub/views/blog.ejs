<header>
    <h1 class="logo-text"><%= textos.BLOG.titulo %></h1>
    <p class="tagline"><%= textos.BLOG.lema %></p>
</header>

<% if (entradas.length) { %>
<ul class="entradas">
    <% entradas.forEach(({ slug, titulo, descripcion, fecha, fechaLegible }) => { %>
    <li class="entrada">
        <h3><a href="/blog/<%= slug %>"><%= titulo %></a></h3>
        <p><%= descripcion %></p>
        <time datetime="<%= fecha %>"><%= fechaLegible %></time>
    </li>
    <% }); %>
</ul>
<% } else { %>
<section class="section-intro">
    <p><%= textos.BLOG.vacio.antes %>
    <a href="<%= comoFunciona %>" rel="noopener"><%= textos.BLOG.vacio.enlace %></a>.</p>
</section>
<% } %>

<%- include('partials/cierre') %>
