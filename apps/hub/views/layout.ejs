<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <script src="/consentimiento.js" data-ga="G-F2JK45VQS3"></script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <meta name="description" content="<%= description %>">
    <meta name="keywords" content="<%= keywords %>">
    <meta name="author" content="CartasMagic.es">
    <meta name="robots" content="<%= typeof noindex !== 'undefined' && noindex ? 'noindex, follow' : 'index, follow, max-snippet:-1, max-image-preview:large' %>">
    <link rel="canonical" href="<%= canonical %>">

    <!-- Iconos -->
    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <link rel="manifest" href="/site.webmanifest">
    <meta name="theme-color" content="#0a0a0f">

    <!-- Open Graph -->
    <meta property="og:title" content="<%= og_title %>">
    <meta property="og:description" content="<%= og_description %>">
    <meta property="og:url" content="<%= canonical %>">
    <meta property="og:type" content="<%= typeof og_type !== 'undefined' ? og_type : 'website' %>">
    <meta property="og:locale" content="es_ES">
    <meta property="og:site_name" content="CartasMagic.es">

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= og_title %>">
    <meta name="twitter:description" content="<%= og_description %>">

    <!-- Schema.org JSON-LD -->
    <script type="application/ld+json">
    <%- ld_json %>
    </script>

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Mana Font (MTG mana symbols) -->
    <link href="https://cdn.jsdelivr.net/npm/mana-font@latest/css/mana.css" rel="stylesheet" type="text/css">

    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <% if (typeof conNav !== 'undefined' && conNav) { %>
    <nav class="site-nav" aria-label="<%= textos.NAV.etiqueta %>">
        <a href="/" class="marca"><%= textos.MARCA.nombre %><span class="logo-tld"><%= textos.MARCA.tld %></span></a>
        <div class="enlaces">
            <a href="/blog"><%= textos.NAV.guias %></a>
            <a href="<%= cta %>" rel="noopener"><%= textos.NAV.vender %></a>
        </div>
    </nav>
    <% } %>

    <main class="container">
        <%- body %>

        <footer>
            <p>&copy; <%= textos.PIE.copyright %> &mdash; <%= textos.PIE.titular %>
                &middot; <a href="mailto:<%= textos.PIE.correo %>"><%= textos.PIE.correo %></a>
                &middot; <a href="<%= avisoLegal %>" rel="noopener"><%= textos.PIE.avisoLegal %></a>
                &middot; <button type="button" class="enlace-cookies" data-abrir-cookies><%= textos.PIE.cookies %></button></p>
        </footer>
    </main>
    <div id="aviso-cookies" class="aviso-cookies" role="region" aria-label="<%= textos.AVISO_COOKIES.etiqueta %>" hidden>
        <p><%= textos.AVISO_COOKIES.texto %> <a href="<%= avisoCookies %>" rel="noopener"><%= textos.AVISO_COOKIES.masInfo %></a></p>
        <div class="aviso-cookies-botones">
            <button type="button" class="aviso-cookies-boton" data-consentimiento="rechazar"><%= textos.AVISO_COOKIES.rechazar %></button>
            <button type="button" class="aviso-cookies-boton" data-consentimiento="aceptar"><%= textos.AVISO_COOKIES.aceptar %></button>
        </div>
    </div>
</body>
</html>
