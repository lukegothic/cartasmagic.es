<div class="main-container">
    <div class="center-text">
        <h1><%= textos.PORTADA.h1 %></h1>
        <p class="hero-claim"><%= textos.PORTADA.reclamo %></p>
        <p><a href="/valoracion-cartas-magic" class="btn-mythic"><%= textos.PORTADA.llamadaPrincipal %></a></p>
        <p class="text-muted"><%- textos.PORTADA.notaMinuto %></p>
        <p class="text-muted"><%- textos.PORTADA.notaCardmarket %></p>
    </div>

    <h2 class="center-text"><%= textos.PORTADA.comoFunciona.titulo %></h2>
    <div class="mtg-card mtg-card-margin">
        <div class="simple-steps">
            <% textos.PORTADA.comoFunciona.pasos.forEach(({ titulo, cuerpo }, i) => { %>
            <div class="step">
                <div class="step-number"><%= i + 1 %></div>
                <p><strong><%= titulo %></strong><br><%= cuerpo %></p>
            </div>
            <% }) %>
        </div>
        <p class="center-text"><a href="/valoracion-cartas-magic" class="btn-mythic"><%= textos.PORTADA.llamadaEtiqueta %></a></p>
    </div>

    <div class="mtg-card mtg-card-margin">
        <h2><%= textos.PORTADA.sinTienda.titulo %></h2>
        <% textos.PORTADA.sinTienda.parrafos.forEach((parrafo) => { %>
        <p><%= parrafo %></p>
        <% }) %>
    </div>

    <div class="mtg-card mtg-card-margin">
        <h2><%= textos.PORTADA.queCompramos.titulo %></h2>
        <p><strong><%= textos.PORTADA.queCompramos.etiquetaSi %></strong> <%= textos.PORTADA.queCompramos.si %></p>
        <p><strong><%= textos.PORTADA.queCompramos.etiquetaNo %></strong> <%= textos.PORTADA.queCompramos.no %></p>
        <p><strong><%= textos.PORTADA.queCompramos.etiquetaSube %></strong> <%= textos.PORTADA.queCompramos.sube %></p>
        <p class="text-muted"><%= textos.PORTADA.queCompramos.nota %></p>
    </div>

    <div class="mtg-card mtg-card-margin">
        <h2><%= textos.PORTADA.antesNoDespues.titulo %></h2>
        <ul class="plain-list">
            <% textos.PORTADA.antesNoDespues.puntos.forEach(({ destacado, resto }) => { %>
            <li><strong><%= destacado %></strong> <%= resto %></li>
            <% }) %>
        </ul>
    </div>

    <div class="mtg-card mtg-card-margin">
        <h2><%= textos.PORTADA.faqTitulo %></h2>
        <% faq.forEach(({ q, a }) => { %>
            <h3><%= q %></h3>
            <p><%= a %></p>
        <% }) %>
    </div>

    <div class="center-text">
        <p><a href="/valoracion-cartas-magic" class="btn-mythic"><%= textos.PORTADA.llamadaEtiqueta %></a></p>
        <p class="text-muted"><%= textos.PORTADA.notaSinCompromiso %></p>
    </div>

    <p class="center-text"><a href="/como-vender-cartas-magic" class="link-mythic"><%= textos.PORTADA.enlaceComparativa %></a></p>
</div>
