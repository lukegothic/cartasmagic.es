<!DOCTYPE html>
<html lang="es">
<head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-6PJYPF57RF"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-6PJYPF57RF');
    </script>
    <link rel="stylesheet" href="style.css">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title><%= title %></title>
    <link rel="icon" type="image/png" sizes="32x32" href="favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="48x48" href="favicon-48x48.png">
    <link rel="icon" type="image/png" sizes="192x192" href="favicon-192x192.png">
    <link rel="apple-touch-icon" sizes="180x180" href="apple-touch-icon.png">
    <meta name="description" content="<%= description %>">
    <meta name="keywords" content="<%= keywords %>">
    <meta name="robots" content="<%= typeof noindex !== 'undefined' && noindex ? 'noindex, follow' : 'index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1' %>">
    <link rel="canonical" href="<%= canonical %>">
    <meta name="theme-color" content="#f5901e">
    <meta name="author" content="contacto@vendercartasmagic.es">
    <meta property="og:title" content="<%= og_title %>">
    <meta property="og:description" content="<%= og_description %>">
    <meta property="og:image" content="/og-image.jpg">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:url" content="<%= og_url %>">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="VenderCartasMagic">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= og_title %>">
    <meta name="twitter:description" content="<%= og_description %>">
    <meta name="twitter:image" content="/og-image.jpg">
    <meta name="twitter:site" content="@vendercartasmagic">
    <script type="application/ld+json">
    <%- ld_json %>
    </script>
</head>
<body>
    <header class="site-header">
        <div class="header-content">
            <div class="logo-container">
                <img src="magic_logo_black-69593323a0ba9347e74d005ad167625e.png" alt="Magic: The Gathering Logo" class="magic-logo">
            </div>
        </div>
    </header>
    <%- body %>
    <footer class="site-footer">
        <div class="footer-content">
            <div class="certification-container">
                <a href="Certified_ProfessionalSeller_ES.pdf" target="_blank" title="Certificado Professional Seller de Cardmarket">
                    <img src="Certified_ProfessionalSeller_ES.jpg" alt="Certified Professional Seller" class="certification-badge">
                </a>
                <p><a href="https://www.cardmarket.com/es/Magic/Users/ivan-the-seller" target="_blank" rel="noopener">Ver perfil en Cardmarket</a></p>
            </div>
            <p class="footer-guias">
                ¿Quieres saber cómo se calcula el precio de una carta? Lee las
                <a href="https://cartasmagic.es/blog?utm_source=vendercartasmagic&utm_medium=footer&utm_campaign=guias" rel="noopener">guías sobre el valor de las cartas Magic</a>
                en CartasMagic.es
            </p>
            <p class="footer-legal">
                Iván Pérez &middot; NIF 72808254Y &middot; Pamplona (Navarra)<br>
                <a href="mailto:contacto@vendercartasmagic.es">contacto@vendercartasmagic.es</a> &middot;
                <a href="/aviso-legal">Aviso legal y condiciones</a>
            </p>
        </div>
    </footer>
    <script>
    // Mide el paso anterior al formulario: de los que entran por la portada, cuantos
    // llegan siquiera a verlo. La posicion distingue los tres botones que llevan al
    // mismo sitio, para saber cual funciona.
    (function () {
        if (typeof gtag !== 'function') return;
        var botones = document.querySelectorAll('a.btn-mythic[href^="/valoracion"], a.btn-mythic[href^="/presupuesto"]');
        Array.prototype.forEach.call(botones, function (boton, i) {
            boton.addEventListener('click', function () {
                gtag('event', 'clic_cta', {
                    event_category: 'navegacion',
                    event_label: boton.getAttribute('href'),
                    posicion: i + 1,
                    pagina: window.location.pathname
                });
            });
        });
    })();
    </script>
</body>
</html>