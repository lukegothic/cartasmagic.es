<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <script src="/consentimiento.js" data-ga="G-6PJYPF57RF"<% if (typeof clarityId !== 'undefined' && clarityId) { %> data-clarity="<%= clarityId %>"<% } %>></script>
    <link rel="stylesheet" href="/style.css">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title><%= title %></title>
    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="manifest" href="/site.webmanifest">
    <meta name="description" content="<%= description %>">
    <meta name="keywords" content="<%= keywords %>">
    <meta name="robots" content="<%= typeof noindex !== 'undefined' && noindex ? 'noindex, follow' : 'index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1' %>">
    <link rel="canonical" href="<%= canonical %>">
    <meta name="theme-color" content="#f5901e">
    <meta name="author" content="<%= textos.MARCA.correo %>">
    <meta property="og:title" content="<%= og_title %>">
    <meta property="og:description" content="<%= og_description %>">
    <meta property="og:image" content="/og-image.jpg">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:url" content="<%= og_url %>">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="VenderCartasMagic">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= og_title %>">
    <meta name="twitter:description" content="<%= og_description %>">
    <meta name="twitter:image" content="/og-image.jpg">
    <meta name="twitter:site" content="@vendercartasmagic">
    <script type="application/ld+json">
    <%- ld_json %>
    </script>
</head>
<body>
    <header class="site-header">
        <div class="header-content">
            <div class="logo-container">
                <img src="/magic_logo_black-69593323a0ba9347e74d005ad167625e.png" alt="<%= textos.MARCA.logoAlt %>" class="magic-logo">
            </div>
        </div>
    </header>
    <%- body %>
    <footer class="site-footer">
        <div class="footer-content">
            <div class="certification-container">
                <a href="/Certified_ProfessionalSeller_ES.pdf" target="_blank" title="<%= textos.PIE.certificadoTitulo %>">
                    <img src="/Certified_ProfessionalSeller_ES.jpg" alt="<%= textos.PIE.certificadoAlt %>" class="certification-badge">
                </a>
                <p><a href="https://www.cardmarket.com/es/Magic/Users/ivan-the-seller" target="_blank" rel="noopener"><%= textos.PIE.perfil %></a></p>
            </div>
            <p class="footer-guias">
                <a href="/hotlist"><%= textos.PIE.hotlist %></a>
            </p>
            <p class="footer-guias">
                <%= textos.PIE.guias.antes %>
                <a href="https://cartasmagic.es/blog?utm_source=vendercartasmagic&utm_medium=footer&utm_campaign=guias" rel="noopener"><%= textos.PIE.guias.enlace %></a>
                <%= textos.PIE.guias.despues %>
            </p>
            <p class="footer-legal">
                <%- textos.PIE.titular %><br>
                <a href="mailto:<%= textos.MARCA.correo %>"><%= textos.MARCA.correo %></a> &middot;
                <a href="/aviso-legal"><%= textos.PIE.avisoLegal %></a> &middot;
                <button type="button" class="enlace-cookies" data-abrir-cookies><%= textos.PIE.cookies %></button>
            </p>
        </div>
    </footer>
    <div id="aviso-cookies" class="aviso-cookies" role="region" aria-label="<%= textos.AVISO_COOKIES.etiqueta %>" hidden>
        <p><%= textos.AVISO_COOKIES.texto %> <a href="/aviso-legal#cookies"><%= textos.AVISO_COOKIES.masInfo %></a></p>
        <div class="aviso-cookies-botones">
            <button type="button" class="aviso-cookies-boton" data-consentimiento="rechazar"><%= textos.AVISO_COOKIES.rechazar %></button>
            <button type="button" class="aviso-cookies-boton" data-consentimiento="aceptar"><%= textos.AVISO_COOKIES.aceptar %></button>
        </div>
    </div>
    <script>
    // Mide el paso anterior al formulario: de los que entran por la portada, cuantos
    // llegan siquiera a verlo. La posicion distingue los tres botones que llevan al
    // mismo sitio, para saber cual funciona.
    (function () {
        if (typeof gtag !== 'function') return;
        var botones = document.querySelectorAll('a.btn-mythic[href^="/valoracion"], a.btn-mythic[href^="/presupuesto"]');
        Array.prototype.forEach.call(botones, function (boton, i) {
            boton.addEventListener('click', function () {
                gtag('event', 'clic_cta', {
                    event_category: 'navegacion',
                    event_label: boton.getAttribute('href'),
                    posicion: i + 1,
                    pagina: window.location.pathname
                });
            });
        });
    })();
    </script>
</body>
</html>