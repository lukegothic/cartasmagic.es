<% if (enviado) { %>
    <script>
        if (typeof gtag === 'function') {
            gtag('event', 'generate_lead', { event_category: 'formulario', event_label: '<%= etiquetaConversion %>' });
        }
    </script>
    <div class="form-feedback">
        <h2>Recibido</h2>
        <p><%= textoRecibido %></p>
    </div>
<% } %>
<% if (errorCode) { %>
    <div class="form-feedback">
        <p><%= mensajeError %></p>
    </div>
<% } %>
