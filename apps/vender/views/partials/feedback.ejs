<% if (enviado) { %>
    <script>
        if (typeof gtag === 'function') {
            gtag('event', 'generate_lead', { event_category: 'formulario', event_label: '<%= etiquetaConversion %>' });
        }
    </script>
    <div class="form-feedback">
        <h2>Recibido</h2>
        <p><%= textoRecibido %></p>
    </div>
<% } %>
<% if (errorCode) { %>
    <script>
        // Cierra el embudo por abajo: un envio rechazado por el backend explica el hueco
        // entre el intento de envio y el lead, y dice que validacion concreta lo frena.
        if (typeof gtag === 'function') {
            gtag('event', 'envio_rechazado', { event_category: 'formulario', event_label: '<%= etiquetaConversion %>', codigo: '<%= errorCode %>' });
        }
    </script>
    <div class="form-feedback">
        <p><%= mensajeError %></p>
    </div>
<% } %>
