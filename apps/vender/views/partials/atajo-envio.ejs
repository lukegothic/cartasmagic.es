<div class="atajo-envio">
    <label for="direccion"><%= textos.FORMULARIO.direccion.label %></label>
    <textarea id="direccion" name="direccion" rows="3" autocomplete="street-address" placeholder="<%- textos.FORMULARIO.direccion.placeholder %>"><%= valores.direccion || '' %></textarea>
    <p class="atajo-nota"><%= textos.FORMULARIO.direccion.nota %></p>
</div>
