<div class="main-container main-container-narrow">
    <div class="center-text">
        <h1><%= textos.VALORACION.h1 %></h1>
        <p class="contact-intro"><%= textos.VALORACION.intro %></p>
    </div>

    <div class="mtg-card mtg-card-margin">
        <%- include('partials/feedback') %>
        <%- include('partials/atajo-manabox') %>
        <form class="lead-form" method="post" action="/valoracion-cartas-magic">
            <label for="nombre"><%= textos.FORMULARIO.nombre.label %></label>
            <input type="text" id="nombre" name="nombre" required autocomplete="name" placeholder="<%= textos.FORMULARIO.nombre.placeholder %>" value="<%= valores.nombre || '' %>">

            <label for="email"><%= textos.FORMULARIO.email.label %></label>
            <input type="email" id="email" name="email" required autocomplete="email" placeholder="<%= textos.FORMULARIO.email.placeholder %>" value="<%= valores.email || '' %>">

            <label for="volumen"><%= textos.FORMULARIO.volumen.label %></label>
            <select id="volumen" name="volumen" required>
                <option value=""><%= textos.FORMULARIO.volumen.vacia %></option>
                <% textos.FORMULARIO.volumen.opciones.forEach(({ valor, texto }) => { %>
                <option value="<%= valor %>"<% if (valores.volumen === valor) { %> selected<% } %>><%= texto %></option>
                <% }) %>
            </select>

            <%- include('partials/atajo-envio') %>

            <label for="mensaje"><%= textos.FORMULARIO.mensaje.label %></label>
            <textarea id="mensaje" name="mensaje" rows="3" placeholder="<%= textos.FORMULARIO.mensaje.placeholderValoracion %>"><%= valores.mensaje || '' %></textarea>

            <button type="submit" class="btn-mythic"><%= textos.VALORACION.boton %></button>
            <p class="form-nota-envio"><%= textos.VALORACION.notaEnvio %></p>

            <%- include('partials/form-legal') %>
        </form>
        <%- include('partials/medicion-embudo') %>
    </div>

    <div class="mtg-card mtg-card-margin">
        <h2><%= textos.VALORACION.despues.titulo %></h2>
        <div class="simple-steps">
            <% textos.VALORACION.despues.pasos.forEach((paso, i) => { %>
            <div class="step">
                <div class="step-number"><%= i + 1 %></div>
                <p><%= paso %></p>
            </div>
            <% }) %>
        </div>
        <p class="text-muted center-text"><%= textos.VALORACION.despues.nota %></p>
    </div>

    <div class="mtg-card mtg-card-margin">
        <h2><%= textos.VALORACION.condiciones.titulo %></h2>
        <ul class="plain-list">
            <% textos.VALORACION.condiciones.puntos.forEach((punto) => { %>
            <li><%= punto %></li>
            <% }) %>
        </ul>
        <p class="center-text"><a href="/aviso-legal" class="link-mythic"><%= textos.VALORACION.condiciones.enlace %></a></p>
    </div>

    <p class="center-text text-muted"><%= textos.VALORACION.escribir.antes %>
        <a href="mailto:<%= textos.MARCA.correo %>?subject=<%= textos.VALORACION.escribir.asunto %>"><%= textos.MARCA.correo %></a>
    </p>
</div>
