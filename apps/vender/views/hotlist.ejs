<div class="main-container">
    <h1><%= textos.HOTLIST.h1 %></h1>
    <p><%= textos.HOTLIST.intro %></p>
    <p class="text-muted"><%= textos.HOTLIST.actualizadaEtiqueta %> <%= actualizada %></p>

    <p class="hotlist-aviso">
        <%= textos.HOTLIST.aviso.antes %>
        <a href="<%= enlaceEstados %>" rel="noopener"><%= textos.HOTLIST.aviso.enlace %></a>
        <%= textos.HOTLIST.aviso.despues %>
    </p>

    <ul class="hotlist-rejilla">
        <% cartas.forEach(({ name, set_name, image_uris, pagamos }) => { %>
        <li class="hotlist-carta">
            <img src="<%= image_uris.normal %>" alt="<%= name %>" width="244" height="340" loading="lazy">
            <p class="hotlist-nombre"><%= name %></p>
            <p class="hotlist-edicion"><%= set_name %></p>
            <p class="hotlist-precio"><span class="hotlist-precio-etiqueta"><%= textos.HOTLIST.pagamosEtiqueta %></span> <%= formatoPrecio(pagamos) %></p>
        </li>
        <% }) %>
    </ul>

    <p class="hotlist-aviso">
        <%= textos.HOTLIST.aviso.antes %>
        <a href="<%= enlaceEstados %>" rel="noopener"><%= textos.HOTLIST.aviso.enlace %></a>
        <%= textos.HOTLIST.aviso.despues %>
    </p>

    <h2><%= textos.HOTLIST.condiciones.titulo %></h2>
    <ul class="plain-list">
        <% textos.HOTLIST.condiciones.puntos.forEach(({ destacado, resto }) => { %>
        <li><strong><%= destacado %></strong> <%= resto %></li>
        <% }) %>
    </ul>

    <h2><%= textos.HOTLIST.faltaTuCarta.titulo %></h2>
    <p><%= textos.HOTLIST.faltaTuCarta.cuerpo %></p>

    <p class="center-text"><a href="/valoracion-cartas-magic" class="btn-mythic"><%= textos.HOTLIST.llamada %></a></p>
    <p class="center-text text-muted"><%= textos.HOTLIST.notaLlamada %></p>
</div>
