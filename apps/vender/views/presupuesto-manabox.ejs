<div class="main-container main-container-narrow">
    <div class="center-text">
        <h1><%= textos.MANABOX.h1 %></h1>
        <p class="contact-intro"><%= textos.MANABOX.intro %></p>
    </div>

    <div class="mtg-card mtg-card-margin">
        <%- include('partials/feedback') %>
        <form class="lead-form" method="post" action="/presupuesto-manabox">
            <label for="url"><%= textos.FORMULARIO.url.label %></label>
            <input type="url" id="url" name="url" required placeholder="<%= textos.FORMULARIO.url.placeholder %>" value="<%= valores.url || '' %>">

            <label for="nombre"><%= textos.FORMULARIO.nombre.label %></label>
            <input type="text" id="nombre" name="nombre" required autocomplete="name" placeholder="<%= textos.FORMULARIO.nombre.placeholder %>" value="<%= valores.nombre || '' %>">

            <label for="email"><%= textos.FORMULARIO.email.label %></label>
            <input type="email" id="email" name="email" required autocomplete="email" placeholder="<%= textos.FORMULARIO.email.placeholder %>" value="<%= valores.email || '' %>">

            <%- include('partials/atajo-envio') %>

            <label for="mensaje"><%= textos.FORMULARIO.mensaje.label %></label>
            <textarea id="mensaje" name="mensaje" rows="3" placeholder="<%= textos.FORMULARIO.mensaje.placeholderManabox %>"><%= valores.mensaje || '' %></textarea>

            <button type="submit" class="btn-mythic"><%= textos.MANABOX.boton %></button>
            <p class="form-nota-envio"><%= textos.MANABOX.notaEnvio %></p>

            <%- include('partials/form-legal') %>
        </form>
        <%- include('partials/medicion-embudo') %>

        <p class="center-text text-muted"><%= textos.MANABOX.sinManabox.antes %>
            <a href="/valoracion-cartas-magic" class="link-mythic"><%= textos.MANABOX.sinManabox.enlace %></a>
        </p>
    </div>

    <div class="mtg-card mtg-card-margin">
        <h2><%= textos.MANABOX.comoSacarEnlace.titulo %></h2>
        <div class="simple-steps">
            <% textos.MANABOX.comoSacarEnlace.pasos.forEach((paso, i) => { %>
            <div class="step">
                <div class="step-number"><%= i + 1 %></div>
                <p><%= paso %></p>
            </div>
            <% }) %>
        </div>
        <p class="text-muted center-text"><%= textos.MANABOX.comoSacarEnlace.nota %></p>
    </div>

</div>
