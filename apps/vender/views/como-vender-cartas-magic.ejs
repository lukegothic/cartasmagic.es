<div class="main-container">
    <h1><%= textos.COMPARATIVA.h1 %></h1>
    <p><%= textos.COMPARATIVA.intro %></p>

    <% textos.COMPARATIVA.opciones.forEach(({ titulo, parrafos, conviene }) => { %>
    <h2><%= titulo %></h2>
    <% parrafos.forEach((parrafo) => { %>
    <p><%= parrafo %></p>
    <% }) %>
    <p><strong><%= textos.COMPARATIVA.convieneEtiqueta %></strong> <%= conviene %></p>
    <% }) %>

    <h2><%= textos.COMPARATIVA.proceso.titulo %></h2>
    <ol class="plain-list">
        <% textos.COMPARATIVA.proceso.pasos.forEach(({ destacado, resto }) => { %>
        <li><strong><%= destacado %></strong> <%= resto %></li>
        <% }) %>
    </ol>

    <h2><%= textos.COMPARATIVA.antesDeVender.titulo %></h2>
    <% textos.COMPARATIVA.antesDeVender.puntos.forEach(({ destacado, resto }) => { %>
    <p><strong><%= destacado %></strong> <%= resto %></p>
    <% }) %>

    <p class="center-text"><a href="/valoracion-cartas-magic" class="btn-mythic"><%= textos.COMPARATIVA.llamada %></a></p>
    <p class="center-text text-muted"><%= textos.COMPARATIVA.notaLlamada %></p>
</div>
