# Correo (obligatorio: sin esto no sale ningún aviso)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_TO=

# Tope de espera al servidor de correo. Sin esto nodemailer espera hasta dos minutos
# y la peticion del visitante se queda colgada.
SMTP_TIMEOUT_MS=8000

# Porcentaje que se paga en cada tramo, sobre el precio de Cardmarket de cada carta.
# Se escribe como número entero: 60 significa el 60 %.
# Los cortes de tramo (20 €, 5 €, 1 €, 0,30 €) están en lib/presupuesto.js.
TRAMO_PREMIUM_PCT=60
TRAMO_ALTA_PCT=50
TRAMO_MEDIA_PCT=35
TRAMO_BAJA_PCT=20

# El bulk se paga por carta, no por porcentaje. En euros.
TRAMO_BULK_EUR=0.02

# Por debajo de esta oferta el aviso llega marcado, para decidir si compensa contestar.
OFERTA_MINIMA=50

# Descarga del mazo de ManaBox y tope de envíos del mismo mazo por hora.
MANABOX_TIMEOUT_MS=10000
MANABOX_MAXIMO_POR_HORA=5
