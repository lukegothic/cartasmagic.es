# Correo (obligatorio: sin esto no sale ningún aviso)
# Si el proveedor bloquea la salida por el 587, usar el 465 con SMTP_SECURE=true.
# Para comprobarlo desde el servidor: node scripts/probar-correo.js
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_TO=

# Tope de espera al servidor de correo. Sin esto nodemailer espera hasta dos minutos
# y la peticion del visitante se queda colgada.
SMTP_TIMEOUT_MS=8000

# Porcentaje que se paga en cada tramo, sobre el precio de Cardmarket de cada carta.
# Se escribe como número entero: 70 significa el 70 %.
# Los cortes de tramo (20 €, 5 €, 1 €, 0,50 €) están en lib/presupuesto.js.
TRAMO_PREMIUM_PCT=70
TRAMO_ALTA_PCT=60
TRAMO_MEDIA_PCT=35
TRAMO_BAJA_PCT=20

# El bulk se paga por carta, no por porcentaje, y a dos tarifas: una rara de bulk se
# revende y una común no. En euros por carta.
TRAMO_BULK_RARA_EUR=0.05
TRAMO_BULK_EUR=0.005

# Por debajo de esta oferta el aviso llega marcado, para decidir si compensa contestar.
OFERTA_MINIMA=50

# Descarga del mazo de ManaBox y tope de envíos del mismo mazo por hora.
MANABOX_TIMEOUT_MS=10000
MANABOX_MAXIMO_POR_HORA=5

# Clave de la valoración interna (/interno/valoracion), que calcula la oferta de un mazo
# sin mandar ningún correo. Se pide por el cuadro del navegador, donde el usuario da igual:
# lo único que se comprueba es la clave. Sin esta variable la página se cierra para todos,
# también para ti, que es lo que evita que un despliegue despistado la deje abierta.
VALORACION_PRIVADA_PASSWORD=
